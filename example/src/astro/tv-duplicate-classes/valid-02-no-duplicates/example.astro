---
// ✅ Valid: All unique classes

import { tv } from 'tailwind-variants';

const button = tv({
		base: 'flex items-center justify-between',
		variants: {
			size: {
				sm: 'text-sm px-2 py-1',
				lg: 'text-lg px-4 py-2'
			}
		}
	});
---

<button class={button({ size: 'sm' })}>No duplicates</button>
